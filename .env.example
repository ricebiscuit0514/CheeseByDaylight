# Firebase 웹 앱 설정값입니다. NEXT_PUBLIC_* 값은 브라우저에서 볼 수 있으며
# 비밀 자격 증명이 아닙니다. 실제 접근 권한은 Firebase Security Rules가 통제합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# 예: https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
# 끝에 / 를 붙이지 마세요.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check의 reCAPTCHA Enterprise 사이트 키입니다.
# 로컬 개발에서는 비워 둘 수 있지만, 프로덕션 연동에는 필수입니다.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Discord/OG 미리보기용 사이트 주소입니다. 커스텀 도메인을 쓰면 여기에 넣으세요.
# 예: https://cheesebydaylight.vercel.app
NEXT_PUBLIC_SITE_URL=
